# Supabase project (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build absolute URLs (e.g. in metadata). Set to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Center contact info shown on the storefront - keep in sync with the Google Business Profile
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_CENTER_PHONE=
NEXT_PUBLIC_CENTER_ADDRESS=
NEXT_PUBLIC_CENTER_HOURS=

# Optional - leave blank to disable analytics wiring entirely
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_INTAKE=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_WHATSAPP=

# WhatsApp bot (server-only - never prefix these with NEXT_PUBLIC_). See docs/WHATSAPP_BOT.md.
# Leave blank to keep the bot off; the rest of the site works without them.
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
